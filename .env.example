# Copy to ignored .env and set private values. Existing volumes retain their existing credentials.
DB_USERNAME=
DB_PASSWORD=
REDIS_PASSWORD=
# Generate: python3 -c 'import secrets; print(secrets.token_hex(32))'
JWT_SECRET=
CORS_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173
# HTTP local development only; production must use true and HTTPS.
COOKIE_SECURE=false
HIBERNATE_DDL_AUTO=update
# Required only by docker-compose.tls.yml; directory contains fullchain.pem and privkey.pem.
TLS_CERT_DIR=
